@mjml()
  <mjml>
    <mj-head>
      <mj-title>
        Confirmation de votre inscription - Plateforme Hackatruite
      </mj-title>
      <mj-font name="Roboto" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700" />
      <mj-attributes>
        <mj-all font-family="Roboto, Arial, sans-serif" />
      </mj-attributes>
      <mj-style>
        .link-nostyle { color: inherit; text-decoration: none }
        .footer-link { color: #888888; text-decoration: none }
      </mj-style>
    </mj-head>
    <mj-body background-color="#F4F4F4">
      <mj-section background-color="#ffffff" padding-top="0">
        <mj-column>
          <mj-spacer height="20px" />
          <mj-text font-size="20px" font-weight="bold" align="center" color="#2525e6">
            Confirmation de votre inscription
          </mj-text>
          <mj-text font-size="16px" line-height="24px" padding-top="20px">
            Bonjour,
          </mj-text>
          <mj-text font-size="16px" line-height="24px">
            Merci de vous être inscrit sur notre newsletter du hackathon (Hackatruite). Pour valider votre inscription, veuillez confirmer votre adresse email en cliquant sur le bouton ci-dessous.
          </mj-text>

          <mj-button
            background-color="#2525e6"
            color="white"
            border-radius="4px"
            font-size="16px"
            font-weight="bold"
            inner-padding="15px 30px"
            href="{{ confirmation_url }}"
          >
            Confirmer mon inscription
          </mj-button>

          <mj-text font-size="16px" line-height="24px">
            Si le bouton ne fonctionne pas, vous pouvez également copier et coller le lien suivant dans votre navigateur :
          </mj-text>

          <mj-text font-size="14px" color="#2525e6" align="center">
            {{ confirmation_url }}
          </mj-text>

          <mj-text font-size="16px" line-height="24px" padding-top="20px">
            Nous sommes impatients de vous voir participer à nos prochains événements !
          </mj-text>

          <mj-text font-size="16px" line-height="24px">
            Cordialement,<br />
            {{ author_names }}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding-top="0">
        <mj-column>
          <mj-divider border-color="#EEEEEE" border-width="1px" padding-top="20px" padding-bottom="0" />
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding-top="0">
        <mj-column>
          <mj-text font-size="12px" line-height="20px" color="#888888" align="center">
            Cet email a été envoyé à {{ email_to }} car vous vous êtes inscrit sur la newsletter Hackathon.
          </mj-text>
          <mj-text font-size="12px" line-height="20px" color="#888888" align="center">
            <a href="{{ unsubscribe_link }}" class="footer-link">Se désinscrire</a>&nbsp;|&nbsp;<a href="{{ privacy_policy_link }}" class="footer-link">Politique de confidentialité</a>
          </mj-text>
          <mj-text font-size="12px" line-height="20px" color="#888888" align="center">
            © 2025 Plateforme Hackatruite. Tous droits réservés.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-body>
  </mjml>
@end
